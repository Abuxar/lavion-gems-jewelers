{
  "version": 2,
  "buildCommand": "npm run build --prefix server 2>/dev/null || exit 0",
  "public": false,
  "functions": {
    "api/index.js": {
      "memory": 3008,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
