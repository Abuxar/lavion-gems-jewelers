{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "server/db/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin-panel",
      "destination": "/"
    },
    {
      "source": "/product/(.*)",
      "destination": "/product"
    },
    {
      "source": "/collection/(.*)",
      "destination": "/collection"
    }
  ]
}
