# =============================================================================
# Lavion Gems & Jewellers — environment configuration
# Copy to server/.env for local development, and set the same keys in the
# Vercel dashboard for production. Never commit real values.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public origin of the site. Must match the OAuth redirect URIs registered with
# each provider, and is used to build links in outgoing emails.
PUBLIC_BASE_URL=http://localhost:5000

# Comma-separated browser origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- Secrets ----------------------------------------------------------------
# Minimum 32 characters. The server refuses to start in production without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# --- Database ---------------------------------------------------------------
# Required. Accounts, refresh tokens and rate-limit counters all live here;
# the JSON file fallback cannot persist on serverless hosting.
MONGO_URI=

# --- Admin ------------------------------------------------------------------
# Store a bcrypt hash, never the password itself.
# Generate: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Email (Resend) ---------------------------------------------------------
# Without these, verification and password-reset emails cannot be delivered.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lavion Gems & Jewellers <no-reply@yourdomain.com>
ADMIN_EMAIL=laviongems.jewellers@gmail.com

# --- Google Sign-In ---------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application
# Authorised redirect URI: {PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple Sign-In ----------------------------------------------------------
# Requires a paid Apple Developer Program membership.
# developer.apple.com -> Certificates, Identifiers & Profiles
#   1. Create an App ID with "Sign In with Apple" enabled
#   2. Create a Services ID (this is APPLE_SERVICES_ID) and enable Sign In with Apple
#   3. Register the return URL: {PUBLIC_BASE_URL}/api/auth/apple/callback
#   4. Create a Sign In with Apple key and download the .p8 file
# Apple will not accept http://localhost — it needs a real HTTPS domain.
# Paste the .p8 contents with literal \n between lines, wrapped in quotes.
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"

# --- Facebook Sign-In -------------------------------------------------------
# developers.facebook.com -> My Apps -> Create App -> Facebook Login
# Valid OAuth Redirect URI: {PUBLIC_BASE_URL}/api/auth/facebook/callback
# Public use requires Meta app review for the "email" permission.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Optional: WhatsApp / Twilio -------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
